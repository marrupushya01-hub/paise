# Copy this file to .env and fill in real values for your environment.
# Never commit the real .env file.

# Port the server listens on.
PORT=4000

# Comma-separated list of browser origins allowed to call this API.
# No wildcard by design — list every real frontend origin.
ALLOWED_ORIGINS=http://localhost:3000

# Protects /api/user-data, /api/insights, and /api/ask with an
# `x-api-key` header. Leave unset for local, no-auth demo mode —
# but always set this before deploying anywhere reachable off your
# machine.
PAISE_API_KEY=

# Optional: your own Anthropic API key, used to power real answers
# from the /api/ask ("Ask Paise") endpoint. Without this, /api/ask
# returns a clearly-labelled stub response instead of calling out
# to any AI provider.
ANTHROPIC_API_KEY=
