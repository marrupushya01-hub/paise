{
  "name": "paise-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch server.js",
    "test": "echo \"No tests yet\" && exit 0",
    "lint": "eslint .",
    "reset-db": "node -e \"const fs=require('fs'),b=process.env.PAISE_DB_PATH||'./paise.db';for(const s of ['','-wal','-shm'])fs.rmSync(b+s,{force:true});console.log('[paise] removed '+b+' \u2014 it will be re-seeded on next start')\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "morgan": "^1.11.0"
  }
}
