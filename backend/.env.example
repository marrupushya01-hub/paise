# Copy this file to .env and fill in real values for your environment.
# Never commit the real .env file.

# Port the server listens on.
PORT=4000

# Comma-separated list of browser origins allowed to call this API.
# No wildcard by design — list every real frontend origin.
ALLOWED_ORIGINS=http://localhost:3000

# LAN demo escape hatch. With this true, any private-range IPv4 origin
# (10.x, 192.168.x, 172.16-31.x) is accepted on top of the list above, so a
# phone on your hotspot works without pinning today's DHCP address. Leave it
# false anywhere the server is reachable from the internet — that includes
# an ngrok or cloudflared tunnel.
ALLOW_LAN_ORIGINS=false

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# SQLite file. Created and seeded on first boot; delete it to start over.
PAISE_DB_PATH=./paise.db

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------

# Pepper for the OTP and session-token HMACs. Leave unset and the server
# generates one on first boot and stores it in the database, so sessions
# survive a restart without any configuration. Set it explicitly (32+ random
# hex characters) if you want the same secret across more than one machine,
# or want it out of the database file entirely:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this invalidates every existing session and outstanding code.
PAISE_AUTH_SECRET=

# How a sign-in code reaches the user. There is no SMS gateway here.
#   log      — printed to the server terminal (default; use this)
#   response — ALSO returned in the API response body, so an unattended
#              phone on a demo hotspot can sign itself in
# `response` hands a working credential to anyone who can reach the server.
# It is a demo affordance and nothing more. Never leave it on anywhere the
# server is reachable off your own machine.
OTP_DELIVERY=log

# Sign-in code lifetime and the per-challenge wrong-guess budget. A code is
# single-use, and requesting a new one invalidates every outstanding code for
# that number.
OTP_TTL_MS=300000
OTP_MAX_ATTEMPTS=5

# Session lifetime. Tokens are 256 bits from the CSPRNG and only their HMAC
# is stored, so the database never holds a usable session.
SESSION_TTL_MS=86400000

# ---------------------------------------------------------------------------
# Ask Paise (local model)
# ---------------------------------------------------------------------------

# /api/ask ("Ask Paise") talks to a locally hosted Ollama model. No API key
# and no per-token cost, and the financial snapshot never leaves the host.
# Install Ollama, then: ollama pull qwen3:8b
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen3:8b

# Context window. A prompt larger than this does not get truncated — it
# wedges the Ollama runner at 100% CPU and every later request queues behind
# it. Raise this before enlarging the snapshot sent to the model.
OLLAMA_NUM_CTX=8192

# An 8B model on CPU takes tens of seconds per answer. Lower this only if
# you are running on a GPU. Answers stream token by token, so this is the
# budget for the whole answer, not for first output.
OLLAMA_TIMEOUT_MS=120000
