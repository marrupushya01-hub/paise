# Copy to .env.local and adjust. Anything prefixed NEXT_PUBLIC_ is baked into
# the client bundle — never put a real secret here.
#
# There is no credential in this file any more. Authentication is a session
# token the backend mints at sign-in and the browser holds per account; the
# shared `NEXT_PUBLIC_PAISE_API_KEY` that used to ship inside the bundle is
# gone. Nothing here is secret, which is the point.

# Where the Paise backend is listening. Leave this unset for local and LAN
# testing: the client then calls the same host the page came from, on the
# port below, so http://<lan-ip>:3000 on a phone reaches your machine's API.
# Set it only to point at a backend somewhere else.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Port the backend listens on, used by the same-host default above.
NEXT_PUBLIC_API_PORT=4000
